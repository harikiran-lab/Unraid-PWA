UNRAID_BFF_PORT=3001
UNRAID_BFF_ORIGIN=http://localhost:5173,http://localhost:2442
UNRAID_BFF_ENCRYPTION_KEY=
UNRAID_BFF_ALLOW_SELF_SIGNED=true
UNRAID_BFF_TRUST_PROXY=false

## Optional: exact API base URL of the Unraid host running this container.
## Enables local NVIDIA readings ONLY when this server is selected in the app.
## Example: https://192.168.1.10:3443 (must match the server URL saved in the UI).
UNRAID_BFF_GPU_SERVER_URL=
